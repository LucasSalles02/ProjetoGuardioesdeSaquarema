{
  "name": "guardioes-de-saquarema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "backend": "node --env-file-if-exists=.env scripts/backend.js serve",
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "dev:backend": "node --env-file-if-exists=.env scripts/backend.js serve",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:backend": "node --env-file-if-exists=.env scripts/backend.js test",
    "dev:frontend": "vite",
    "admin:create": "node --env-file-if-exists=.env scripts/backend.js admin",
    "test:backend:legacy": "node --test \"backend/test/**/*.test.js\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/backend.js migrate",
    "db:import:sqlite": "node --env-file-if-exists=.env scripts/backend.js import-sqlite",
    "db:check": "node --env-file-if-exists=.env scripts/backend.js check",
    "db:setup:local": "node --env-file-if-exists=.env scripts/postgres-local.js setup",
    "db:start": "node --env-file-if-exists=.env scripts/postgres-local.js start",
    "db:stop": "node --env-file-if-exists=.env scripts/postgres-local.js stop",
    "backend:legacy": "node --env-file-if-exists=.env backend/legacy/server.js"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
